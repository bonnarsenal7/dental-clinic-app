# Copy to .env.local and fill in. .env.local is gitignored — never commit
# real values.

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Crash reporting (Phase 6). Optional: leave blank and Sentry never
# initialises, which is what local development and CI want. Set it for the
# deployed clinic build so crashes after launch are visible.
VITE_SENTRY_DSN=
